{
  "manifest_version": 3,
  "name": "FunPay Plus",
  "version": "1.3.4",
  "description": "Живые обои, тёмная тема и инструменты продавца для FunPay",
  "permissions": [
    "storage",
    "cookies",
    "alarms",
    "notifications",
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "chat_frame", "enabled": true, "path": "frame-rules.json" }
    ]
  },
  "host_permissions": [
    "https://funpay.com/*",
    "https://translate.googleapis.com/*",
    "https://translate-pa.googleapis.com/*",
    "https://translation.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FunPay Plus"
  },
  "content_scripts": [
    {
      "matches": [
        "https://funpay.com/*"
      ],
      "js": [
        "mute-site.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://funpay.com/*"
      ],
      "js": [
        "lib/pixi.min.js",
        "lib/unsafe-eval.min.js",
        "lib/live2dcubismcore.min.js",
        "lib/cubism4.min.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://funpay.com/*"
      ],
      "js": [
        "palette.js",
        "sounds.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "live2d/*",
        "live2d/*/*",
        "live2d/*/*/*",
        "live2d/*/*/*/voice/*",
        "live2d/*/*/voice/*"
      ],
      "matches": [
        "https://funpay.com/*"
      ]
    }
  ]
}